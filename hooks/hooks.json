{
  "description": "Skill nudge hook for the moneymoney plugin",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/nudge-skill.sh"
          }
        ]
      }
    ]
  }
}
