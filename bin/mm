#!/usr/bin/env bash
#
# Plugin shim for an independently installed `mm` binary.
#
# The plugin never downloads or executes release artifacts. Install `mm` from
# reviewed source, then keep it on PATH; this shim only avoids re-executing
# itself when the plugin's bin directory is present on PATH.

set -euo pipefail

self_dir="$(cd "$(dirname "$0")" && pwd -P)"
clean_entries=()
IFS=':' read -r -a path_entries <<< "${PATH:-}"
for entry in "${path_entries[@]}"; do
  entry_dir="${entry:-.}"
  if entry_physical="$(cd -- "$entry_dir" 2>/dev/null && pwd -P)" &&
    [[ "$entry_physical" == "$self_dir" ]]; then
    continue
  fi
  clean_entries+=("$entry")
done
IFS=':' clean_path="${clean_entries[*]}"

if real_mm="$(PATH="$clean_path" command -v mm 2>/dev/null)"; then
  exec "$real_mm" "$@"
fi

cat >&2 <<'EOF'
mm: no independently installed binary was found on PATH.

Build the reviewed source locally:
  git clone https://github.com/parithosh/moneymoney.git
  cd moneymoney
  cargo install --path . --locked

Then retry this command. The plugin deliberately does not download or bypass
Gatekeeper for prebuilt executables.
EOF
exit 127
